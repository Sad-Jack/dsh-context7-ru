{
  "name": "dsh-context7",
  "version": "0.2.0-ru.3",
  "description": "Поиск актуальной документации и примеров кода библиотек.",
  "private": false,
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "locale",
    "README*.md",
