    "cordis": ">=4.0.0-rc.8 <5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "context7",
    "documentation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sad-Jack/dsh-context7-ru.git"
  },
  "homepage": "https://github.com/Sad-Jack/dsh-context7-ru#readme",
